# Copie ce fichier en `.env.local` et remplis tes clés Supabase.
# Où les trouver ? Supabase Dashboard → ton projet → Settings → API.
#
# Tant que ces clés sont vides, l'app tourne en MODE DÉMO :
# les comptes et l'onboarding sont stockés dans le navigateur (localStorage).
# Dès que tu ajoutes les clés, l'app utilise le vrai backend Supabase
# (auth + table `profiles` — voir supabase/migrations/00001_init.sql).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=